def quick_sort(arr):
    if len(arr) <= 1:
        return arr
    left =[]
    right = []
    pivot  = arr[-1]

    for x in arr[:-1]:
        if pivot >= x:
            left.append(x)
        else:
            right.append(x)
    return quick_sort(left) + [pivot] + quick_sort(right)
 
