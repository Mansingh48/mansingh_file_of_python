def selection_sort(arr):
    if len(arr) <= 1:
        return arr
    for i in range(len(arr)):
        index = i
        for j in range(i+1 , len(arr)):
            if arr[j] < arr[index]:
                arr[j] , arr[index] = arr[index] , arr[j]
        # print(arr)
    return arr
